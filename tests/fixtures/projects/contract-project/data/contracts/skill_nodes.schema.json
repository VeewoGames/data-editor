    "affectsRules": {"type":"object","required":["fields","required","non_empty_array_fields","entity_selection_default","constraints"],"additionalProperties":false,"properties":{"fields":{"$ref":"#/$defs/stringArray"},"required":{"$ref":"#/$defs/stringArray"},"non_empty_array_fields":{"$ref":"#/$defs/stringArray"},"entity_selection_default":{"type":"string"},"constraints":{"type":"array","items":{"$ref":"#/$defs/affectsConstraint"}}}},
    "affectsConstraint": {"type":"object","required":["operator","code_key"],"additionalProperties":false,"properties":{"operator":{"enum":["affects_required_for_entity_consumer","affects_forbidden_for_cells_only_consumer","direction_affects_requires_area"]},"code_key":{"type":"string","minLength":1}}},
    "paramConstraint": {"type":"object","additionalProperties":false,"properties":{"required":{"$ref":"#/$defs/stringArray"},"integer_min":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"odd":{"$ref":"#/$defs/stringArray"},"non_empty_arrays":{"$ref":"#/$defs/stringArray"},"offset_pair_integers":{"type":"boolean"}}},
    "derivedRule": {"type":"object","additionalProperties":false,"properties":{"selection_type":{"type":"string"},"distance_source":{"type":"string"},"path":{"type":"string"},"occupancy":{"type":"string"},"pattern":{"type":"string"},"directions":{"$ref":"#/$defs/stringArray"},"target":{"type":"string"},"requires_active_movement":{"type":"boolean"},"min_targets":{"type":"integer","minimum":1},"max_targets":{"type":"integer","minimum":1},"min_distance":{"type":"integer","minimum":0},"forbidden_relations":{"$ref":"#/$defs/stringArray"},"forbid":{"$ref":"#/$defs/stringArray"}}},
    "validationRules": {"type":"object","required":["field_constraints","blocking_codes"],"additionalProperties":false,"properties":{"field_constraints":{"type":"object","additionalProperties":{"$ref":"#/$defs/fieldConstraint"}},"blocking_codes":{"type":"object","additionalProperties":{"type":"string","minLength":1}}}},
    "fieldConstraint": {"type":"object","required":["type","code"],"additionalProperties":false,"properties":{"type":{"enum":["integer","number"]},"min":{"type":"number"},"max":{"type":"number"},"code":{"type":"string","minLength":1}}},
    "metadata": {"type":"object","required":["nodes","fields"],"additionalProperties":false,"properties":{"nodes":{"type":"object","additionalProperties":{"type":"string","minLength":1}},"fields":{"type":"object","additionalProperties":{"type":"string","minLength":1}}}},
    "arrayItem": {"type":"object","required":["type"],"additionalProperties":false,"properties":{"type":{"enum":["int","float","string","bool","array","dict","node"]},"min":{"type":"number"},"max":{"type":"number"},"options":{"type":"array","items":{"type":"string"},"uniqueItems":true},"allowed_node_types":{"$ref":"#/$defs/stringArray"},"fields":{"type":"array","items":{"$ref":"#/$defs/field"}},"items":{"$ref":"#/$defs/arrayItem"}},"allOf":[{"if":{"properties":{"type":{"const":"array"}},"required":["type"]},"then":{"properties":{"items":{"$ref":"#/$defs/arrayItem"}},"required":["items"]}},{"if":{"properties":{"type":{"const":"dict"}},"required":["type"]},"then":{"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/field"}}},"required":["fields"]}}]},
    "field": {"type":"object","required":["name","type"],"additionalProperties":false,"properties":{"name":{"type":"string","minLength":1},"type":{"enum":["int","float","string","bool","array","dict"]},"required":{"type":"boolean"},"default":{},"min":{"type":"number"},"max":{"type":"number"},"options":{"type":"array","items":{"type":"string"},"uniqueItems":true},"fields":{"type":"array","items":{"$ref":"#/$defs/field"}},"items":{"$ref":"#/$defs/arrayItem"},"visible_when":{"type":"object"},"targeting_scope":{"enum":["cast","deferred"]}},"allOf":[{"if":{"properties":{"type":{"const":"array"}},"required":["type"]},"then":{"properties":{"items":{"$ref":"#/$defs/arrayItem"}},"required":["items"]}},{"if":{"properties":{"type":{"const":"dict"}},"required":["type"]},"then":{"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/field"}}},"required":["fields"]}}]},
    "node": {"type":"object","required":["fields","consumes","accepted_capabilities","candidate_gate"],"additionalProperties":false,"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/field"}},"consumes":{"type":"array","items":{"enum":["cells","entities","direction","none"]},"uniqueItems":true},"accepted_capabilities":{"$ref":"#/$defs/stringArray"},"candidate_gate":{"oneOf":[{"type":"boolean"},{"type":"object"}]},"roles":{"type":"array","items":{"enum":["deploy"]},"uniqueItems":true}}}
  }
