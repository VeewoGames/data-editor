        "normalization": {"type":"object","required":["targeting_order","selection_order","area_order","affects_order","movement_order","omit_explicit_defaults","omit_empty_containers"],"additionalProperties":false,"properties":{"targeting_order":{"$ref":"#/$defs/stringArray"},"selection_order":{"$ref":"#/$defs/stringArray"},"area_order":{"$ref":"#/$defs/stringArray"},"affects_order":{"$ref":"#/$defs/stringArray"},"movement_order":{"$ref":"#/$defs/stringArray"},"omit_explicit_defaults":{"type":"boolean"},"omit_empty_containers":{"type":"boolean"}}},
        "validation": {"$ref":"#/$defs/validationRules"},
