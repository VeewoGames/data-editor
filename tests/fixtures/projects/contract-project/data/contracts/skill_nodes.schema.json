    "selectionRules": {"type":"object","required":["discriminator","types","patterns","visibility","occupancy","relations","entity_types","directions","defaults","fields_by_type","consumer_by_type","required_by_type","non_empty_array_fields"],"additionalProperties":false,"properties":{"discriminator":{"const":"type"},"types":{"$ref":"#/$defs/stringArray"},"patterns":{"$ref":"#/$defs/stringArray"},"visibility":{"$ref":"#/$defs/stringArray"},"occupancy":{"$ref":"#/$defs/stringArray"},"relations":{"$ref":"#/$defs/stringArray"},"entity_types":{"$ref":"#/$defs/stringArray"},"directions":{"$ref":"#/$defs/stringArray"},"defaults":{"type":"object","additionalProperties":false,"properties":{"pattern":{},"visibility":{},"min_targets":{},"max_targets":{},"directions":{}}},"fields_by_type":{"type":"object","additionalProperties":{"$ref":"#/$defs/stringArray"}},"consumer_by_type":{"type":"object","required":["self","entity","entity_result","cell","direction"],"additionalProperties":false,"properties":{"self":{"enum":["cells","entities","direction","none"]},"entity":{"enum":["cells","entities","direction","none"]},"entity_result":{"enum":["cells","entities","direction","none"]},"cell":{"enum":["cells","entities","direction","none"]},"direction":{"enum":["cells","entities","direction","none"]}}},"required_by_type":{"type":"object","additionalProperties":{"$ref":"#/$defs/stringArray"}},"non_empty_array_fields":{"$ref":"#/$defs/stringArray"}}},
